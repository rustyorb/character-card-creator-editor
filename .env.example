# Your LLM API Key (Required)
LLM_API_KEY=your_api_key_here

# Base URL for the API (Optional, defaults to Gemini if not set, or OpenAI default if using that path)
# If you are using an OpenAI-compatible provider, set this.
# LLM_API_BASE=https://api.openai.com/v1

# Model ID (Optional, defaults to provider specific default)
# LLM_MODEL=gpt-4o
